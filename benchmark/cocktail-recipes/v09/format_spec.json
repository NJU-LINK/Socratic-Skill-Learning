{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IBA Cocktail Recipe",
  "type": "object",
  "required": [
    "name",
    "glass",
    "category",
    "ingredients",
    "garnish",
    "preparation"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical cocktail name"
    },
    "glass": {
      "type": "string",
      "minLength": 1,
      "description": "Type of glass used to serve"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "IBA category"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "required": ["ingredient", "amount", "unit"]
          },
          {
            "required": ["special"]
          }
        ],
        "properties": {
          "ingredient": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": ["string", "null"]
          },
          "special": {
            "type": "string",
            "minLength": 1,
            "description": "Nonstandard measure, such as dashes, slices, or sprigs"
          }
        },
        "additionalProperties": false
      }
    },
    "garnish": {
      "type": ["string", "null"]
    },
    "preparation": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
