    uni:partOfUniversity uni:Sorbonne .

uni:Physics_ETH a uni:Department ;
    uni:partOfUniversity uni:ETHZurich .

uni:Computing_ETH a uni:Department ;
    uni:partOfUniversity uni:ETHZurich .

uni:Biology_MIT a uni:Department ;
    uni:partOfUniversity uni:MIT .

uni:Sloan_MIT a uni:Department ;
    uni:partOfUniversity uni:MIT .

uni:MediaLab_MIT a uni:Department ;
    uni:partOfUniversity uni:MIT .

uni:Engineering_LMU a uni:Department ;
    uni:partOfUniversity uni:LMU .

uni:Robotics_LMU a uni:Department ;
    uni:partOfUniversity uni:LMU .

uni:Engineering_Berkeley a uni:Department ;
    uni:partOfUniversity uni:Berkeley .

uni:AI_Berkeley a uni:Department ;
    uni:partOfUniversity uni:Berkeley .

uni:Robotics_UPM a uni:Department ;
    uni:partOfUniversity uni:UPM .

uni:AI_UPM a uni:Department ;
    uni:partOfUniversity uni:UPM .

uni:HistoryAndPhilosophy_NKUA a uni:Department ;
    uni:partOfUniversity uni:NKUA .

# ---------------------------
# Courses
# ---------------------------
uni:CS101 a uni:Course ;
    uni:isTaughtIn uni:ComputerScience_NTUA .

uni:AI101 a uni:Course ;
    uni:isTaughtIn uni:ComputerScience_NTUA .

uni:KnowledgeGraphs_NTUA a uni:Course ;
    uni:isTaughtIn uni:DataScience_NTUA .

uni:DistributedSystems_NTUA a uni:Course ;
    uni:isTaughtIn uni:DataScience_NTUA .

uni:Math101 a uni:Course ;
    uni:isTaughtIn uni:Mathematics_IST .

uni:Math201 a uni:Course ;
    uni:isTaughtIn uni:Mathematics_Sorbonne .

uni:Optimization_IST a uni:Course ;
    uni:isTaughtIn uni:AppliedMath_IST .

uni:Geometry_Sorbonne a uni:Course ;
    uni:isTaughtIn uni:AppliedMath_Sorbonne .

uni:Physics301 a uni:Course ;
    uni:isTaughtIn uni:Physics_ETH .

uni:QuantumSystems_ETH a uni:Course ;
    uni:isTaughtIn uni:Physics_ETH .

uni:ScientificComputing_ETH a uni:Course ;
    uni:isTaughtIn uni:Computing_ETH .

uni:Bio101 a uni:Course ;
    uni:isTaughtIn uni:Biology_MIT .

uni:Bioinformatics_MIT a uni:Course ;
    uni:isTaughtIn uni:Biology_MIT .

uni:Innovation_MIT a uni:Course ;
    uni:isTaughtIn uni:Sloan_MIT .

uni:DataEthics_MIT a uni:Course ;
    uni:isTaughtIn uni:MediaLab_MIT .

uni:Eng202 a uni:Course ;
    uni:isTaughtIn uni:Engineering_LMU .

uni:AutonomousSystems_LMU a uni:Course ;
    uni:isTaughtIn uni:Robotics_LMU .

uni:EngUS302 a uni:Course ;
    uni:isTaughtIn uni:Engineering_Berkeley .

uni:MLSystems_Berkeley a uni:Course ;
    uni:isTaughtIn uni:AI_Berkeley .

uni:Robotics101_UPM a uni:Course ;
    uni:isTaughtIn uni:Robotics_UPM .

uni:Vision_UPM a uni:Course ;
    uni:isTaughtIn uni:AI_UPM .

uni:STS101 a uni:Course ;
    uni:isTaughtIn uni:HistoryAndPhilosophy_NKUA .

# ---------------------------
# Professors
# ---------------------------
uni:Alex_Morgan a uni:Person ;
    uni:hasName "Alex Morgan" ;
    uni:role "Professor of Computer Science" ;
    uni:teaches uni:CS101 , uni:AI101 , uni:KnowledgeGraphs_NTUA ;
    uni:worksAt uni:ComputerScience_NTUA , uni:DataScience_NTUA .

uni:Thomas_Berger a uni:Person ;
    uni:hasName "Thomas Berger" ;
    uni:role "Assistant Professor of Computer Science" ;
    uni:teaches uni:CS101 , uni:DistributedSystems_NTUA ;
    uni:worksAt uni:ComputerScience_NTUA , uni:DataScience_NTUA .

uni:Felix_Wagner a uni:Person ;
    uni:hasName "Felix Wagner" ;
    uni:role "Professor of Mathematics" ;
    uni:teaches uni:Math101 , uni:AI101 , uni:Optimization_IST ;
    uni:worksAt uni:Mathematics_IST , uni:AppliedMath_IST .

uni:Martin_Keller a uni:Person ;
    uni:hasName "Martin Keller" ;
    uni:role "Professor of History of Scienceand Technology" ;
    uni:teaches uni:STS101 ;
    uni:worksAt uni:HistoryAndPhilosophy_NKUA .

uni:John_Smith a uni:Person ;
    uni:hasName "John Smith" ;
    uni:role "Professor of Biology" ;
    uni:teaches uni:Bio101 , uni:Bioinformatics_MIT ;
    uni:worksAt uni:Biology_MIT .

uni:Marie_Dubois a uni:Person ;
    uni:hasName "Marie Dubois" ;
    uni:role "Professor of Mathematics" ;
    uni:teaches uni:Math201 , uni:Geometry_Sorbonne ;
    uni:worksAt uni:Mathematics_Sorbonne , uni:AppliedMath_Sorbonne .

uni:Stefan_Mueller a uni:Person ;
    uni:hasName "Stefan Mueller" ;
    uni:role "Assistant Professor of Engineering" ;
    uni:teaches uni:Eng202 , uni:AutonomousSystems_LMU ;
    uni:worksAt uni:Engineering_LMU , uni:Robotics_LMU .

uni:Elena_Rossi a uni:Person ;
    uni:hasName "Elena Rossi" ;
    uni:role "Professor of Physics" ;
    uni:teaches uni:Physics301 , uni:QuantumSystems_ETH , uni:ScientificComputing_ETH ;
    uni:worksAt uni:Physics_ETH , uni:Computing_ETH .

uni:Carlos_Martin a uni:Person ;
    uni:hasName "Carlos Martin" ;
    uni:role "Assistant Professor of Robotics" ;
    uni:teaches uni:Robotics101_UPM , uni:Vision_UPM ;
    uni:worksAt uni:Robotics_UPM , uni:AI_UPM .

uni:Priya_Natarajan a uni:Person ;
    uni:hasName "Priya Natarajan" ;
    uni:role "Professor of Innovation" ;
    uni:teaches uni:Innovation_MIT , uni:DataEthics_MIT ;
    uni:worksAt uni:Sloan_MIT , uni:MediaLab_MIT .

uni:David_Lee a uni:Person ;
    uni:hasName "David Lee" ;
    uni:role "Professor of Artificial Intelligence" ;
    uni:teaches uni:EngUS302 , uni:MLSystems_Berkeley ;
    uni:worksAt uni:Engineering_Berkeley , uni:AI_Berkeley .

uni:Sofia_Lindqvist a uni:Person ;
    uni:hasName "Sofia Lindqvist" ;
    uni:role "Assistant Professor of Data Science" ;
    uni:teaches uni:KnowledgeGraphs_NTUA , uni:DistributedSystems_NTUA ;
    uni:worksAt uni:DataScience_NTUA , uni:ComputerScience_NTUA .

uni:Lukas_Weber a uni:Person ;
    uni:hasName "Lukas Weber" ;
    uni:role "Research Staff" ;
    uni:teaches uni:ScientificComputing_ETH ;
    uni:worksAt uni:Computing_ETH .

uni:Jane_Petterson a uni:Person ;
    uni:hasName "Jane Petterson" ;
    uni:role "Lecturer" ;
    uni:teaches uni:EngUS302 ;
    uni:worksAt uni:Engineering_Berkeley .

uni:Marco_Silva a uni:Person ;
    uni:hasName "Marco Silva" ;
    uni:role "Administrative Staff" ;
    uni:worksAt uni:AppliedMath_IST .

