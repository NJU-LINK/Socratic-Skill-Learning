    uni:profileKeyword "simulation" .

uni:Diego_Lopez a uni:Person ;
    uni:hasName "Diego Lopez" ;
    uni:role "Lecturer in Robotics" ;
    uni:hasAcademicRank uni:LecturerRank ;
    uni:worksAt uni:Robotics_UPM ;
