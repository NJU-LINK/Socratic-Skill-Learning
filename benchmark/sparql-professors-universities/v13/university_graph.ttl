    uni:profileKeyword "teaching labs" , "industrial projects" .

uni:Karin_Lindqvist a uni:Person ;
    uni:hasName "Karin Lindqvist" ;
    uni:role "Research Administrator" ;
    uni:worksAt uni:Sloan_MIT ;
    uni:profileKeyword "grants" .

