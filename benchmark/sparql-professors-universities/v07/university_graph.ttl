@prefix uni: <http://university.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------
# Universities
# ---------------------------
uni:AuroraTechnicalUniversity a uni:University ;
    uni:hasName "Aurora Technical University" ;
    uni:locatedInCountry "SE" .

uni:BalticInstituteOfTechnology a uni:University ;
    uni:hasName "Baltic Institute of Technology" ;
    uni:locatedInCountry "FI" .

uni:CascadiaStateUniversity a uni:University ;
    uni:hasName "Cascadia State University" ;
    uni:locatedInCountry "US" .

uni:DanubeResearchUniversity a uni:University ;
    uni:hasName "Danube Research University" ;
    uni:locatedInCountry "AT" .

uni:HeliosPolytechnic a uni:University ;
    uni:hasName "Helios Polytechnic" ;
    uni:locatedInCountry "GR" .

uni:MeridianUniversity a uni:University ;
    uni:hasName "Meridian University" ;
    uni:locatedInCountry "NL" .

uni:NorthbridgeUniversity a uni:University ;
    uni:hasName "Northbridge University" ;
    uni:locatedInCountry "CA" .

uni:RedwoodInstituteOfScience a uni:University ;
    uni:hasName "Redwood Institute of Science" ;
    uni:locatedInCountry "US" .

# ---------------------------
# Departments
# ---------------------------
uni:ComputerScience_ATU a uni:Department ;
    uni:hasName "Department of Computer Science" ;
    uni:partOfUniversity uni:AuroraTechnicalUniversity .

uni:Mathematics_BIT a uni:Department ;
    uni:hasName "Department of Mathematics" ;
    uni:partOfUniversity uni:BalticInstituteOfTechnology .

uni:MarineSystems_BIT a uni:Department ;
    uni:hasName "Department of Marine Systems" ;
    uni:partOfUniversity uni:BalticInstituteOfTechnology .

uni:Physics_CSU a uni:Department ;
    uni:hasName "Department of Physics" ;
    uni:partOfUniversity uni:CascadiaStateUniversity .

uni:PublicPolicy_DRU a uni:Department ;
    uni:hasName "School of Public Policy" ;
    uni:partOfUniversity uni:DanubeResearchUniversity .

uni:Economics_DRU a uni:Department ;
    uni:hasName "Department of Economics" ;
    uni:partOfUniversity uni:DanubeResearchUniversity .

uni:Materials_HP a uni:Department ;
    uni:hasName "Department of Materials Engineering" ;
    uni:partOfUniversity uni:HeliosPolytechnic .

uni:Biology_NU a uni:Department ;
    uni:hasName "Department of Biology" ;
    uni:partOfUniversity uni:NorthbridgeUniversity .

uni:Sociology_MU a uni:Department ;
    uni:hasName "Department of Sociology" ;
    uni:partOfUniversity uni:MeridianUniversity .

uni:Linguistics_MU a uni:Department ;
    uni:hasName "Department of Linguistics" ;
    uni:partOfUniversity uni:MeridianUniversity .

uni:AI_RIS a uni:Department ;
    uni:hasName "School of Artificial Intelligence" ;
    uni:partOfUniversity uni:RedwoodInstituteOfScience .

# ---------------------------
# Institutes
# ---------------------------
uni:DataScienceInstitute_ATU a uni:Institute ;
    uni:hasName "Data Science Institute" ;
    uni:belongsToUniversity uni:AuroraTechnicalUniversity .

uni:QuantumSystemsInstitute_CSU a uni:Institute ;
    uni:hasName "Quantum Systems Institute" ;
    uni:belongsToUniversity uni:CascadiaStateUniversity .

uni:AdvancedMaterialsInstitute_HP a uni:Institute ;
    uni:hasName "Advanced Materials Institute" ;
    uni:belongsToUniversity uni:HeliosPolytechnic .

uni:DigitalSocietyInstitute_MU a uni:Institute ;
    uni:hasName "Digital Society Institute" ;
    uni:belongsToUniversity uni:MeridianUniversity .

uni:ClimateInstitute_NU a uni:Institute ;
    uni:hasName "Climate Informatics Institute" ;
    uni:belongsToUniversity uni:NorthbridgeUniversity .

uni:ComputationInstitute_RIS a uni:Institute ;
    uni:hasName "Institute for Computation" ;
    uni:belongsToUniversity uni:RedwoodInstituteOfScience .

# ---------------------------
# Research Centers
# ---------------------------
uni:RoboticsCenter_ATU a uni:ResearchCenter ;
    uni:hasName "Center for Robotics and Adaptive Systems" ;
    uni:hostedByUniversity uni:AuroraTechnicalUniversity .

uni:BioDesignCenter_BIT a uni:ResearchCenter ;
    uni:hasName "BioDesign and Coastal Analytics Center" ;
    uni:hostedByUniversity uni:BalticInstituteOfTechnology .

uni:PhotonicsCenter_CSU a uni:ResearchCenter ;
    uni:hasName "Photonics and Quantum Networks Center" ;
    uni:hostedByUniversity uni:CascadiaStateUniversity .

uni:RiverSystemsCenter_DRU a uni:ResearchCenter ;
    uni:hasName "River Systems Data Center" ;
    uni:hostedByUniversity uni:DanubeResearchUniversity .

uni:SolarFuturesCenter_HP a uni:ResearchCenter ;
    uni:hasName "Solar Futures Research Center" ;
    uni:hostedByUniversity uni:HeliosPolytechnic .

uni:CivicDataCenter_MU a uni:ResearchCenter ;
    uni:hasName "Civic Data and Institutions Center" ;
    uni:hostedByUniversity uni:MeridianUniversity .

uni:GenomicsCenter_NU a uni:ResearchCenter ;
    uni:hasName "Genomics and Resilient Health Center" ;
    uni:hostedByUniversity uni:NorthbridgeUniversity .

uni:VisionCenter_RIS a uni:ResearchCenter ;
    uni:hasName "Vision and Robotics Center" ;
    uni:hostedByUniversity uni:RedwoodInstituteOfScience .

