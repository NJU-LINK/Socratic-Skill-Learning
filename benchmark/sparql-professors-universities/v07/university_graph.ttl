    uni:isTaughtIn uni:MarineSystems_BIT .

uni:QuantumPhysics301 a uni:Course ;
    uni:isTaughtIn uni:Physics_CSU .

uni:QuantumSystems320 a uni:Course ;
    uni:isTaughtIn uni:Physics_CSU .

uni:PolicyAnalytics330 a uni:Course ;
    uni:isTaughtIn uni:PublicPolicy_DRU .

uni:EconomicNetworks340 a uni:Course ;
    uni:isTaughtIn uni:Economics_DRU .

uni:Materials410 a uni:Course ;
    uni:isTaughtIn uni:Materials_HP .

uni:SustainableManufacturing420 a uni:Course ;
    uni:isTaughtIn uni:Materials_HP .

uni:CompBio430 a uni:Course ;
    uni:isTaughtIn uni:Biology_NU .

uni:ClimateData440 a uni:Course ;
    uni:isTaughtIn uni:Biology_NU .

uni:CivicData450 a uni:Course ;
    uni:isTaughtIn uni:Sociology_MU .

uni:LanguageAndSociety460 a uni:Course ;
    uni:isTaughtIn uni:Linguistics_MU .

uni:MachineVision470 a uni:Course ;
    uni:isTaughtIn uni:AI_RIS .

uni:RoboticPerception480 a uni:Course ;
    uni:isTaughtIn uni:AI_RIS .

