# SSL evaluation harness — environment template.
# Copy to .env and fill in your endpoint. All values can also be provided as
# real environment variables; the file is never committed.

# OpenAI-compatible endpoint used by pi-ai for both the Student and the Educator.
SSL_URL=https://example.invalid/v1
SSL_KEY=your-api-key

# Optional HTTPS proxy for the endpoint (leave empty for a direct connection).
HTTPS_PROXY=

# Optional: Docker image build proxy, if your daemon needs one to pull task images.
DOCKER_PROXY=
